        <mxCell id="oam" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;CloudWatch OAM — Read-Only Metrics Sink&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;Cross-account observability link to the executive view.&lt;br style=&quot;font-size: 15px;&quot;&gt;Metrics only; no cardholder data (PAN) leaves the CDE (NFR-11).&lt;br style=&quot;font-size: 15px;&quot;&gt;CDE Logs/X-Ray stay in the CDE account." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;fontSize=15;fontColor=#232F3E;verticalAlign=top;spacingTop=4;align=left;spacingLeft=6;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
