        <mxCell id="cnote" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Tokenization and Network Gateway run on ECS Fargate inside the CDE; their dashboards live in the CDE account and expose only Four Golden Signals through OAM.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=8;fontStyle=2;align=left;verticalAlign=top;fontColor=#DD344C;" parent="1" vertex="1">
