        <mxCell id="c2" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Network Gateway&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;L: internal P95 &amp;lt; 20 ms (S-05)&lt;br style=&quot;font-size: 15px;&quot;&gt;T: 3,565 req/s&lt;br style=&quot;font-size: 15px;&quot;&gt;E: network declines vs timeouts&lt;br style=&quot;font-size: 15px;&quot;&gt;S: CPU · ISO 8583 session count" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2E5;strokeColor=#ED7100;fontSize=15;fontColor=#232F3E;verticalAlign=top;spacingTop=4;align=left;spacingLeft=6;" parent="1" vertex="1">
